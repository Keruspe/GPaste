#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:74
msgid ""
"Fix selecting a history in the UI sidebar doing nothing, and, when a "
"history's context menu was open, switching to that one instead of the one "
"clicked"
msgstr ""

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:82
msgid ""
"Fix the daemon deadlocking against itself when copying, most often on larger "
"items (text selections are now served by a dedicated content provider "
"instead of being serialized by GTK)"
msgstr ""

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:83
msgid ""
"text/plain is now served as UTF-8, where GTK's serializer encoded it as "
"ASCII and replaced anything else with '?'"
msgstr ""

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:84
msgid "Fix a deadlock when selecting an item that turns out to be invalid"
msgstr ""

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:85
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:176

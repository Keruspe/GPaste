msgid "Fix image files not being deleted when history items are removed"
msgstr ""
"Soluciona archivos de imagen que no son eliminados cuando los elementos del "
"historial son retirados"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:240

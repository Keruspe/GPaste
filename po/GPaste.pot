#: data/appstream/org.gnome.GPaste.Ui.appdata.xml.in:51
msgid ""
"Fix \"gpaste-client\" exiting silently with status 255, instead of showing "
"its usage, on an unknown command or a wrong number of arguments"
msgstr ""


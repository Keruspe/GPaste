#: data/desktop/org.gnome.GPaste.Ui.desktop.in.in:21
msgid "About"
msgstr "Um hugbúnaðinn"

#: data/gsettings/org.gnome.GPaste.gschema.xml:15
msgid "Max size of an element when displaying it"
msgstr "Hámarksstærð einingar við birtingu"

#: data/gsettings/org.gnome.GPaste.gschema.xml:16
msgid ""
"Anything past that length is replaced by \"…\" when an element is shown in "
"the history, and newlines and tabs are shown as spaces. 0 disables the limit."
msgstr ""

#: data/gsettings/org.gnome.GPaste.gschema.xml:23
msgid "Detect and replace growing lines"
msgstr "Finna og skipta út vaxandi línum"

#: data/gsettings/org.gnome.GPaste.gschema.xml:24
msgid ""
"Copying \"Here is\", then \"Here is an example\", leaves two entries in the "
"history. With this enabled, the second replaces the first instead."
msgstr ""
"Sjálfgefið mun það að velja fyrst \"Hér er\" og síðan \"Hér er dæmi\" búa "
"til tvær færslur í vinnsluferlinum. Þegar þessi eiginleiki er virkjaður, "
"verður fyrri færslunni skipt út fyrir þá seinni."

#: data/gsettings/org.gnome.GPaste.gschema.xml:32
msgid "The name of the current history"
msgstr "Heiti fyrirliggjandi ferlis"

#: data/gsettings/org.gnome.GPaste.gschema.xml:33
msgid "The default name is \"history\""
msgstr "Sjálfgefna heitið er \"ferill\""

#: data/gsettings/org.gnome.GPaste.gschema.xml:40
msgid "Save copied images to the history"
msgstr "Vista afritaðar myndir í vinnsluferilinn"

#: data/gsettings/org.gnome.GPaste.gschema.xml:41
msgid "Enabled by default: images are kept alongside text."
msgstr ""

#: data/gsettings/org.gnome.GPaste.gschema.xml:48
msgid "Show image previews in the history"
msgstr "Birta forskoðun mynda í vinnsluferlinum"

#: data/gsettings/org.gnome.GPaste.gschema.xml:49
msgid "Enabled by default: an image item shows a thumbnail of itself."
msgstr ""

#: data/gsettings/org.gnome.GPaste.gschema.xml:57
msgid "Size of image previews in pixels"
msgstr "Breidd forskoðunar mynda í mynddílum"

#: data/gsettings/org.gnome.GPaste.gschema.xml:58
msgid ""
"Size of the inline image thumbnail in the history; the larger detail preview "
"is shown on hover. Default size is 50 pixels."
msgstr ""
"Stærð innfelldrar smámyndar í vinnsluferlinum; stærri forskoðun birtist við "
"yfirsvif bendils. Sjálfgefin stærð er 50 mynddílar."

#: data/gsettings/org.gnome.GPaste.gschema.xml:65
msgid "Close the UI after selecting an item"
msgstr "Loka viðmóti eftir að atriði er valið"

#: data/gsettings/org.gnome.GPaste.gschema.xml:66
#: data/gsettings/org.gnome.GPaste.gschema.xml:224
msgid "Enabled by default."
msgstr ""

#: data/gsettings/org.gnome.GPaste.gschema.xml:73
msgid "Are the global keyboard shortcuts enabled?"
msgstr "Eru flýtileiðir á lyklaborði virkjaðar?"

#: data/gsettings/org.gnome.GPaste.gschema.xml:74
msgid ""
"By default, the global keyboard shortcuts are enabled. Disable this to "
"prevent GPaste from grabbing any global shortcut."
msgstr ""

#: data/gsettings/org.gnome.GPaste.gschema.xml:82
msgid "The keyboard shortcut to launch the graphical interface"
msgstr "Flýtilykill til að ræsa myndræna viðmótið"

#: data/gsettings/org.gnome.GPaste.gschema.xml:83
#: data/gsettings/org.gnome.GPaste.gschema.xml:91
#: data/gsettings/org.gnome.GPaste.gschema.xml:151
#: data/gsettings/org.gnome.GPaste.gschema.xml:176
#: data/gsettings/org.gnome.GPaste.gschema.xml:200
#: data/gsettings/org.gnome.GPaste.gschema.xml:208
#: data/gsettings/org.gnome.GPaste.gschema.xml:258
msgid "An empty string disables this shortcut."
msgstr ""

#: data/gsettings/org.gnome.GPaste.gschema.xml:90
msgid "The keyboard shortcut to mark the active item as being a password"
msgstr "Flýtilyklar til að merkja virka atriðið sem lykilorð"

#: data/gsettings/org.gnome.GPaste.gschema.xml:99
msgid "Max history size"
msgstr "Hámarksstærð ferils"

#: data/gsettings/org.gnome.GPaste.gschema.xml:100
msgid "Maximum number of items in history"
msgstr "Hámarksfjöldi atriða í ferli"

#: data/gsettings/org.gnome.GPaste.gschema.xml:108
msgid "Max memory usage (MB)"
msgstr "Hámarksnotkun minnis (MB)"

#: data/gsettings/org.gnome.GPaste.gschema.xml:109
msgid "Maximum amount of memory used to store contents"
msgstr "Mesta magn minnis sem notað er til að geyma efni"

#: data/gsettings/org.gnome.GPaste.gschema.xml:117
msgid "Max text item size"
msgstr "Hámarksstærð textaatriða"

#: data/gsettings/org.gnome.GPaste.gschema.xml:118
#, fuzzy
msgid ""
"Maximum size of a text item. Anything out of this boundary is ignored, "
"except a text a password manager marked as a secret, which is kept however "
"long."
msgstr "Hámarksstærð textaatriða. Allt utan þessara marka er hunsað."

#: data/gsettings/org.gnome.GPaste.gschema.xml:128
msgid "Min text item size"
msgstr "Lágmarksstærð textaatriða"

#: data/gsettings/org.gnome.GPaste.gschema.xml:129
#, fuzzy
msgid ""
"Minimum size of a text item. Anything out of this boundary is ignored, "
"except a text a password manager marked as a secret, which is kept however "
"short."
msgstr "Lágmarksstærð textaatriða. Allt utan þessara marka er hunsað."

#: data/gsettings/org.gnome.GPaste.gschema.xml:139
msgid "Password timeout"
msgstr "Tímamörk lykilorðs"

#: data/gsettings/org.gnome.GPaste.gschema.xml:140
msgid ""
"How long a password may stay on the clipboard, in seconds, once it is the "
"active item. When it runs out, the next item that is not a password is "
"selected, or the clipboard is emptied if the history holds none. 0 means a "
"password stays for as long as anything else would."
msgstr ""

#: data/gsettings/org.gnome.GPaste.gschema.xml:150
msgid "The keyboard shortcut to delete the first element in history"
msgstr "Flýtilyklar til að eyða fyrstu einingunni í ferlinum"

#: data/gsettings/org.gnome.GPaste.gschema.xml:158
msgid "Let the primary selection affect the history"
msgstr "Láta aðalval (primary - miðjuhnappur) hafa áhrif á feril"

#: data/gsettings/org.gnome.GPaste.gschema.xml:159
#, fuzzy
msgid "Disabled by default: only the clipboard (ctrl+c) affects the history."
msgstr ""
"Sjálfgefið hefur einungis klippispjaldið (ctrl+c) áhrif á vinnsluferilinn."

#: data/gsettings/org.gnome.GPaste.gschema.xml:166
msgid "Save every flavour of copied rich text"
msgstr ""

#: data/gsettings/org.gnome.GPaste.gschema.xml:167
msgid ""
"Enabled by default. When disabled, only the plain text of a rich text "
"selection (HTML and the like) is kept."
msgstr ""

#: data/gsettings/org.gnome.GPaste.gschema.xml:175
msgid "The keyboard shortcut to display the menu"
msgstr "Lyklaborðsvísun til að birta valmyndina"

#: data/gsettings/org.gnome.GPaste.gschema.xml:183
msgid "Where the history is stored"
msgstr "Þar sem ferilinn er geymdur"

#: data/gsettings/org.gnome.GPaste.gschema.xml:184
msgid ""
"The storage backend used to persist the history: \"file\" keeps it in an on-"
"disk file, \"sqlite\" in a per-history database (with \"encrypted-file\" and "
"\"encrypted-sqlite\" flavours), \"none\" keeps nothing."
msgstr ""

#: data/gsettings/org.gnome.GPaste.gschema.xml:191
msgid "Last processed storage backend revision"
msgstr ""

#: data/gsettings/org.gnome.GPaste.gschema.xml:192
msgid ""
"Set by the daemon, not meant to be edited. When it falls behind the daemon’s "
"own revision, the storage migration is offered again on startup."
msgstr ""

#: data/gsettings/org.gnome.GPaste.gschema.xml:199
msgid "The keyboard shortcut to sync the clipboard to the primary selection"
msgstr ""
"Flýtivísun til að samstilla klippispjaldið við aðalval (primary - "
"miðjuhnappur)"

#: data/gsettings/org.gnome.GPaste.gschema.xml:207
msgid "The keyboard shortcut to sync the primary selection to the clipboard"
msgstr ""
"Flýtivísun til að samstilla aðalval (primary - miðjuhnappur) við "
"klippispjaldið"

#: data/gsettings/org.gnome.GPaste.gschema.xml:215
msgid "Keep the primary selection and the clipboard in sync"
msgstr "Halda aðalvali (primary - miðjuhnappur) og klippispjaldi samstilltu"

#: data/gsettings/org.gnome.GPaste.gschema.xml:216
#, fuzzy
msgid ""
"Disabled by default: the primary selection and the clipboard are independent."
msgstr ""
"Sjálfgefið eru aðalval (primary - miðjuhnappur) og klippispjaldið óháð hvort "
"öðru."

#: data/gsettings/org.gnome.GPaste.gschema.xml:223
msgid "Track clipboard changes"
msgstr "Rekja breytingar á klippispjaldi"

#: data/gsettings/org.gnome.GPaste.gschema.xml:231
#, fuzzy
msgid "Match the daemon state to the GNOME Shell extension’s"
msgstr "Samstilla stöðu vaktarans við stöðu viðaukans"

#: data/gsettings/org.gnome.GPaste.gschema.xml:232
msgid ""
"When enabled, disabling the extension stops the daemon tracking as well. "
"Disabled by default: the daemon state is left alone."
msgstr ""

#: data/gsettings/org.gnome.GPaste.gschema.xml:240
#, fuzzy
msgid "Tracking paused while the GNOME Shell extension is away"
msgstr "Virkja gnome-shell skeljarviðbótina"

#: data/gsettings/org.gnome.GPaste.gschema.xml:241
msgid ""
"Kept by the daemon under track-extension-state: set when the extension going "
"away paused the tracking, so that its coming back resumes it, and only then."
msgstr ""

#: data/gsettings/org.gnome.GPaste.gschema.xml:248
msgid "Trim text items before adding them to the history"
msgstr "Stytta textaatriði áður en þeim er bætt í ferilskrá"

#: data/gsettings/org.gnome.GPaste.gschema.xml:249
#, fuzzy
msgid ""
"Trimming removes the leading and trailing whitespace. Disabled by default: "
"items are stored just as they were copied."
msgstr ""
"Stytting þýðir að öll bil á undan og eftir eru fjarlægð. Sjálfgefið látum "
"við þau halda sér."

#: data/gsettings/org.gnome.GPaste.gschema.xml:257
msgid ""
"The keyboard shortcut to upload the first element in history to a pastebin "
"service"
msgstr ""
"Flýtilyklar til að senda fyrsta atriði í ferli inn á úrklippuþjónustu "
"(pastebin)"

#: data/gsettings/org.gnome.GPaste.gschema.xml:265
#, fuzzy
msgid "The command uploading an item to a pastebin service"
msgstr "Senda virkt atriði inn á úrklippuþjónustu (pastebin)"

#: data/gsettings/org.gnome.GPaste.gschema.xml:266
msgid ""
"The item is written to the command’s standard input, and the command must "
"answer the url it uploaded it to -- and nothing else -- on its standard "
"output. It is parsed as a shell command line, so it may carry arguments, but "
"it is not run through a shell: no pipes, no redirections, no globs. "
"wgetpaste, pastebinit and \"nc termbin.com 9999\" all fit this contract. The "
"default needs nothing but curl, and asks it to keep quiet about its progress "
"(-s) while still reporting errors (-S), since anything it writes on standard "
"error ends up in the daemon’s log."
msgstr ""

#: data/gsettings/org.gnome.GPaste.gschema.xml:280
msgid "Ask for confirmation before emptying a history"
msgstr "Kalla eftir staðfestingu áður en ferill er tæmdur"

#: data/gsettings/org.gnome.GPaste.gschema.xml:281
msgid "Enabled by default, because emptying a history cannot be undone."
msgstr ""

#: data/gsettings/org.gnome.GPaste.gschema.xml:288
#, fuzzy
msgid "Run the experimental in-shell (mutter) daemon"
msgstr "Nota innan-skeljar-vaktara (in-shell daemon) á tilraunastigi"

#: data/gsettings/org.gnome.GPaste.gschema.xml:289
msgid ""
"Disabled by default: the GNOME Shell extension is a pure client and the "
"standalone daemon does the work."
msgstr ""


msgid "Support for gnome 46"
msgstr "Поддержка gnome 46"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:243
msgid "Stable release for GNOME 45. Changes:"
msgstr "Стабильный выпуск для GNOME 45. Изменения:"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:245
msgid "Port to gnome 45"
msgstr "Портирован на gnome 45"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:246
msgid "Add setting to open ui window centered"
msgstr ""
"Добавить настройку для открытия окна пользовательского интерфейса по центру"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:255
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:272
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:306
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:362
msgid "Fix a bug leading to history with only one item"
msgstr ""
"Исправлена ошибка, приводившая к открытию истории только с одним элементом"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:261
msgid "First release for GNOME 44. Changes:"
msgstr "Первый выпуск для GNOME 44. Изменения:"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:263
msgid "gcr 4 is now required"
msgstr "теперь требуется gcr 4"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:264
msgid "Port to gnome 44"
msgstr "Портирован на gnome 44"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:280
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:314
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:370
msgid "Avoid crash under heavy memory load"
msgstr "Предотвращение сбоев при большой нагрузке на память"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:288
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:322
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:378
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:454
msgid "Respect --use-index when displaying history"
msgstr "Учитываем --use-index при отображении истории"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:294
msgid "First release for GNOME 43. Changes:"
msgstr "Первый выпуск для GNOME 43. Изменения:"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:296
msgid "Port to GNOME 43"
msgstr "Портирован на GNOME 43"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:297
msgid "Internal preparation for gtk4 port"
msgstr "Внутренняя подготовка к переходу на gtk4"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:330
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:386
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:462
msgid "Open GPaste UI where the mouse pointer is"
msgstr ""
"Открытие пользовательского интерфейса GPaste в том месте, где находится "
"указатель мыши"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:338
msgid "Fixes to the new preferences tool"
msgstr "Исправления в новом инструменте настроек"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:339
msgid "Style fixes"
msgstr "Исправления стиля"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:346
msgid "First release for GNOME 42. Changes:"
msgstr "Первый выпуск для GNOME 42. Изменения:"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:348
msgid ""
"Old libgpaste replaced by a new minimal libgpaste-2 with no gtk dependency"
msgstr ""
"Старая библиотека libgpaste заменена новой минимальной libgpaste-2 без "
"зависимости от gtk"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:349
msgid "New libgpaste-gtk3 for utils and settings ui"
msgstr "Новая libgpaste-gtk3 для утилит и интерфейса настроек"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:350
msgid "New libgpaste-gtk4 for utils and preferences ui"
msgstr "Новая libgpaste-gtk4 для интерфейса утилит и настроек"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:351
msgid "New gtk4 based gpaste-preferences utility"
msgstr "Новая утилита настроек gpaste на основе gtk4"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:352
msgid "Autotools are no longer supported"
msgstr "Автоинструменты больше не поддерживаются"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:353
msgid "Extension updated for gnome-shell 42"
msgstr "Расширение обновлено для gnome-shell 42"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:394
msgid "fix the storage path for meson builds"
msgstr "исправлен путь хранения для сборок мезон"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:402
msgid "fix some race conditions in history handling"
msgstr "исправлены некоторые условия способа обработки истории"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:410
msgid "better fix crash when there is no history yet"
msgstr "улучшено исправление сбоя, когда истории ещё нет"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:418
msgid "fix crash when there is no history yet"
msgstr "исправлен сбой, когда истории ещё нет"


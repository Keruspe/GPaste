msgstr "обновление переводов"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:427
msgid "fix gnome-shell exntesion when the daemon restarts"
msgstr "исправлено расширение gnome-shell при перезапуске демона"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:436
msgid "Fix keybindings for wayland"
msgstr "Исправлены привязки клавиш для Wayland"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:443
msgid "First release for GNOME 41. Changes:"
msgstr "Первый выпуск для GNOME 41. Изменения:"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:445
msgid "port to gnome-shell 41"
msgstr "переход на gnome-shell 41"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:478
msgid "fix a crash in memory usage checking"
msgstr "исправление сбоя при проверке использования памяти"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:485
msgid "First release for GNOME 40. Changes:"
msgstr "Первый выпуск для GNOME 40. Изменения:"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:487
msgid "port to gnome-shell 40"
msgstr "переход на gnome-shell 40"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:488
msgid "placeholder for gnome-shell prefs"

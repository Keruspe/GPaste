#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:511
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:519
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:527
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:535
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:553
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:561
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:570
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:579
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:588
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:596
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:617
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:625
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:633
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:641
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:649
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:665
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:673
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:681
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:689
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:705
msgid "This is a maintenance release. Changes:"
msgstr "Это обслуживающий выпуск. Изменения:"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:74
msgid ""
"Fix selecting a history in the UI sidebar doing nothing, and, when a "
"history's context menu was open, switching to that one instead of the one "
"clicked"
msgstr ""

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:82
msgid ""
"Fix the daemon deadlocking against itself when copying, most often on larger "
"items (text selections are now served by a dedicated content provider "
"instead of being serialized by GTK)"
msgstr ""

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:83
msgid ""
"text/plain is now served as UTF-8, where GTK's serializer encoded it as "
"ASCII and replaced anything else with '?'"
msgstr ""

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:84
msgid "Fix a deadlock when selecting an item that turns out to be invalid"
msgstr ""

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:85
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:176
msgid ""
"Fix the daemon crashing when searching from the GNOME Shell overview with a "
"term containing an unbalanced bracket or parenthesis"
msgstr ""

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:86
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:177
msgid ""
"Fix the history file being destroyed when it had been written by a newer "
"version of GPaste"
msgstr ""

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:87
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:178
msgid ""
"Fix items being lost or garbled when loading a history containing an item "
"with an empty value"
msgstr ""

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:88
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:179
msgid ""
"Fix every client crashing, GNOME Shell included, on the first update sent by "
"a newer daemon after \"gpaste-client daemon-reexec\""
msgstr ""

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:89
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:180
msgid ""
"Fix the daemon aborting, instead of disabling search, when it cannot connect "
"to its own D-Bus proxy"
msgstr ""

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:90
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:181
msgid ""
"Fix \"gpaste-client help\", \"version\", \"ui\" and \"preferences\" failing "
"when no daemon is reachable"
msgstr ""

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:91
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:182
msgid ""
"Fix \"gpaste-client file\" crashing on a file that is neither text nor a "
"loadable image"
msgstr ""

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:92
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:183
msgid ""
"Fix a critical on every keystroke when the GTK UI search term is not a valid "
"regular expression"
msgstr ""

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:93
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:184
msgid ""
"Fix acting on history rows before their content has been loaded, in both the "
"GTK UI and the GNOME Shell extension"
msgstr ""

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:94
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:185
msgid ""
"Fix a second \"gpaste-ui\" or \"gpaste-preferences\" invocation failing "
"instead of presenting the running window"
msgstr ""

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:95
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:186
msgid ""
"Fix several memory leaks and a use-after-free in the GTK UI history panel"
msgstr ""

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:96
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:187
msgid ""
"Fix the \"empty history\" helpers reporting success when the operation had "
"failed"
msgstr ""

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:104
msgid ""
"Fix the active history item overriding the clipboard when copying an image "
"while images support is disabled (such content is now left untouched in the "
"clipboard, while still not being added to the history)"
msgstr ""

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:112
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:195
msgid ""
"Fix the daemon failing to restart with \"gpaste-client daemon-reexec\" (the "
"re-exec path was missing the gpaste libexec subdirectory)"
msgstr ""
"Исправлена ошибка, из-за которой демон не перезапускался с помощью команды "
"«gpaste-client daemon-reexec» (в пути к re-exec отсутствовал подкаталог "
"libexec)"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:120
msgid ""
"GNOME Shell extension: fix history items gradually disappearing from the menu"
msgstr ""
"GNOME Shell extension: Исправлена ошибка, из-за которой элементы истории "
"постепенно исчезали из меню"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:121
msgid ""
"UI: fix keyboard input so Escape and Enter no longer swallow text meant for "
"the search or history switch entries, and type-to-search works right after "
"startup"
msgstr ""
"Пользовательский интерфейс: исправлен ввод с клавиатуры, так что клавиши "
"Escape и Enter больше не «проглатывают» текст, предназначенный для поиска "
"или переключения записей в истории, а функция поиска по мере набора работает "
"сразу после запуска"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:129
msgid "GNOME Shell extension: fix keyboard navigation in the history menu"
msgstr ""
"GNOME Shell extension: исправлена навигация по элементам истории с помощью "
"клавиатуры"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:130
msgid "GNOME Shell extension: give every action button the same width"
msgstr ""
"GNOME Shell extension: всем кнопкам действий присвоена одинаковая ширина"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:138
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:203
msgid "GNOME Shell extension: restore keyboard navigation of history items"
msgstr ""
"GNOME Shell extension: восстановление навигации по элементам истории с "
"помощью клавиатуры"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:139
msgid ""
"GNOME Shell extension: restore the Ctrl index overlay and Ctrl+0-9 selection"
msgstr ""
"GNOME Shell extension: восстановлен функционал Ctrl index и Ctrl+0-9 для "
"выделения"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:140
msgid "Build: require GTK 4.18"
msgstr "Сборка: требуется GTK 4.18"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:141
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:204
msgid "Fix a typo in the French translation"
msgstr "Исправлена опечатка во французском переводе"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:149
msgid "Fix building without the GNOME Shell extension (-Dgnome-shell=false)"
msgstr ""
"Исправлена ошибка при сборке без GNOME Shell extension (-Dgnome-shell=false)"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:150
msgid ""
"Restore GTK deprecation version-gating and drop the unused build-time gjs "
"dependency"
msgstr ""
"Восстановлено ограничение по версиям для GTK и удалена неиспользуемая "
"зависимость gjs, используемая во время сборки"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:151
msgid "Target GNOME Shell 50 in the extension"
msgstr "Для расширения целевой оболочкой является GNOME Shell 50"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:152
msgid "Bump the library soversions to reflect the API/ABI changes since 45.8"
msgstr ""
"Обновлены версии библиотек, чтобы отразить изменения API/ABI, произошедшие с "
"версии 45.8"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:158
msgid ""
"This is a major release porting GPaste to GTK 4 and libadwaita. Changes:"
msgstr ""
"Это крупный выпуск, портирующий GPaste на GTK 4 и libadwaita. Изменения:"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:160
msgid "Port the daemon, history UI and preferences to GTK 4 and libadwaita"
msgstr ""
"Перенесён на GTK 4 и libadwaita демон, пользовательский интерфейс истории и "
"параметров"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:161
msgid "Show image thumbnails in the history, with configurable preview size"
msgstr ""
"Добавлена настройка размера предварительного просмотра миниатюр изображений "
"в истории"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:162
msgid ""
"Support global keyboard shortcuts on Wayland through the XDG GlobalShortcuts "
"portal"
msgstr ""
"Добавлена поддержка глобальных комбинаций клавиш в Wayland через портал XDG "
"GlobalShortcuts"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:163
msgid "Recognise copied colours as dedicated colour items"
msgstr ""
"Распознавание скопированных цветов осуществляется в виде отдельных цветовых "
"элементов"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:164
msgid ""
"Give keybindings human-readable descriptions and install a daemon desktop "
"file"
msgstr ""
"Комбинациям клавиш даны удобочитаемые описания и установлен файл демона "
"рабочего стола"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:165
msgid "Fix images sometimes being repeatedly re-added to the history"
msgstr ""
"Исправлена ошибка, из-за которой изображения иногда повторно добавлялись в "
"историю"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:166
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:213
msgid ""
"Fix keyboard shortcuts not triggering when NumLock and CapsLock are both "
"active"
msgstr ""
"Исправлена ошибка, из-за которой комбинации клавиш не срабатывали при "
"активных NumLock и CapsLock"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:167
msgid ""
"Fix several crashes (search provider, UI lifetime, GNOME Shell extension) "
"and memory leaks"
msgstr ""
"Исправлено несколько сбоев (search provider, UI lifetime, GNOME Shell "
"extension) и утечки памяти"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:168
msgid "Modernise the GNOME Shell extension to current conventions"
msgstr ""
"GNOME Shell extension модернизировано в соответствии с современными "
"стандартами"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:212
msgid "Fix use-after-free crash in the GNOME Shell search provider"
msgstr ""
"Исправлена ошибка, приводящая к сбою из-за использования освобожденной "
"памяти в поставщике поиска GNOME Shell"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:214
msgid ""
"Fix memory leaks when re-copying history items and when rebinding shortcuts"
msgstr ""
"Устранены утечки памяти при повторном копировании элементов истории и "
"повторной привязке клавиш"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:215
msgid "Fix potential crash when enforcing a very small history size"
msgstr ""
"Исправлена потенциальная ошибка, приводящая к сбою при установлении очень "
"малого размера истории"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:216
msgid "Build: ship the GSettings schema as a static file"
msgstr "Сборка: схема GSettings поставляется в виде статического файла"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:224
msgid ""
"GNOME Shell extension now retries the daemon connection before giving up"
msgstr ""
"GNOME Shell extension теперь повторяет попытку подключения к демону, прежде "
"чем прекратить работу"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:225
msgid "Fix test crash when GrabAccelerators is not allowed"
msgstr ""
"Исправлена ошибка, приводящая к сбою теста при недопустимости использования "
"GrabAccelerators"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:226
msgid "Build: simplify gsettings compilation for tests"
msgstr "Сборка: упрощение компиляции gsettings для тестов"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:234
msgid "Fix GC crash and signal leak when disabling the GNOME Shell extension"
msgstr ""
"Исправлены сбои сборщика мусора и утечки памяти при отключении GNOME Shell "
"extension"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:235
msgid "GNOME Shell extension now handles daemon connection failure gracefully"
msgstr ""
"GNOME Shell extension теперь корректно обрабатывает сбои подключения демона"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:236
msgid "Fix crash when a history item has no value yet"
msgstr "Исправлен сбой, когда элемент истории ещё не имеет значения"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:237
msgid "Fix image files not being deleted when history items are removed"
msgstr ""
"Исправлена ошибка, из-за которой файлы изображений не удалялись при удалении "
"элементов истории"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:238
msgid "Fix image files stored in wrong directory"
msgstr ""
"Исправлена ошибка, из-за которой файлы изображений хранились в неправильном "
"каталоге"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:239
msgid "Fix keyboard focus being stolen by history items on hover"
msgstr ""
"Исправлена ошибка, из-за которой фокус клавиатуры перехватывался элементами "
"истории при наведении курсора"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:240
msgid ""
"Fix key events incorrectly forwarded to search when another entry has focus"
msgstr ""
"Исправлена ошибка, из-за которой события нажатия клавиш некорректно "
"перенаправлялись в поиск, когда фокус находился на другой записи"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:241
msgid "Fix signal loop when updating shortcut entries from settings"
msgstr ""
"Исправлено зацикливание сигнала при обновлении записей комбинаций клавиш в "
"настройках"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:242
msgid "Fix default history item count not reset after history deletion"
msgstr ""
"Исправлена ошибка, из-за которой счётчик элементов истории по умолчанию не "
"сбрасывался после удаления истории"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:243
msgid "Enforce minimum window size to prevent unresizable state"
msgstr ""
"Установлен минимальный размер окна, чтобы предотвратить невозможность "
"изменения его размера"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:244
msgid "Add descriptive tooltips for settings entries"
msgstr "Добавлены пояснительные всплывающие подсказки для пунктов настроек"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:245
msgid "Build: explicitly link libgpaste libraries against libc"
msgstr "Сборка: явная привязка библиотеки libgpaste к libc"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:246
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:259
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:269
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:278
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:287
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:296
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:306
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:357
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:399
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:413
msgid "Translations updates"
msgstr "Обновление переводов"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:254
msgid ""
"Fix infinite Pango assertion loop that could fill disk when clipboard "
"content contained tab characters"
msgstr ""
"Исправлена бесконечная циклическая ошибка Pango, которая могла привести к "
"переполнению диска, если содержимое буфера обмена содержало символы табуляции"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:255
msgid "Various bug fixes and memory management improvements"
msgstr "Исправлены различные ошибки и улучшено управление памятью"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:256
msgid "Daemon improvements"
msgstr "Улучшения в работе демона"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:257
msgid "GNOME Shell extension improvements"
msgstr "Улучшения в GNOME Shell extension"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:258
msgid "GLib >= 2.76 is now required"
msgstr "Теперь требуется GLib >= 2.76"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:267
msgid "Support for gnome 50"
msgstr "Поддержка gnome 50"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:268
msgid "Support for gnome 49"
msgstr "Поддержка gnome 49"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:277
msgid "Support for gnome 48"
msgstr "Поддержка gnome 48"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:286
msgid "Support for gnome 47"
msgstr "Поддержка gnome 47"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:295
msgid "Support for gnome 46"
msgstr "Поддержка gnome 46"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:302
msgid "Stable release for GNOME 45. Changes:"
msgstr "Стабильный выпуск для GNOME 45. Изменения:"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:304
msgid "Port to gnome 45"
msgstr "Портирован на gnome 45"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:305
msgid "Add setting to open ui window centered"
msgstr ""
"Добавить настройку для открытия окна пользовательского интерфейса по центру"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:314
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:331
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:365
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:421
msgid "Fix a bug leading to history with only one item"
msgstr ""
"Исправлена ошибка, приводившая к открытию истории только с одним элементом"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:320
msgid "First release for GNOME 44. Changes:"
msgstr "Первый выпуск для GNOME 44. Изменения:"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:322
msgid "gcr 4 is now required"
msgstr "теперь требуется gcr 4"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:323
msgid "Port to gnome 44"
msgstr "Портирован на gnome 44"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:339
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:373
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:429
msgid "Avoid crash under heavy memory load"
msgstr "Предотвращение сбоев при большой нагрузке на память"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:347
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:381
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:437
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:513
msgid "Respect --use-index when displaying history"
msgstr "Учитываем --use-index при отображении истории"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:353
msgid "First release for GNOME 43. Changes:"
msgstr "Первый выпуск для GNOME 43. Изменения:"


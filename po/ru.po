#: data/desktop/org.gnome.GPaste.Daemon.desktop.in.in:3
#: data/desktop/org.gnome.GPaste.Ui.desktop.in.in:3
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:6
msgid "GPaste"
msgstr "GPaste"

#: data/desktop/org.gnome.GPaste.Preferences.desktop.in.in:3
msgid "GPaste Preferences"
msgstr "Настройки GPaste"

#: data/desktop/org.gnome.GPaste.Preferences.desktop.in.in:4
msgid "Manage your GPaste preferences"
msgstr "Управляйте настройками GPaste"

#: data/desktop/org.gnome.GPaste.Preferences.desktop.in.in:5
msgid "Clipboard;Manager;Settings;Preferences;Configuration;"
msgstr "Clipboard;Manager;Settings;Preferences;Configuration;Буфер;Обмена;Менеджер;Настройки;Предпочтения;Конфигурация;"

#: data/desktop/org.gnome.GPaste.Ui.desktop.in.in:4
msgid "Clipboard Manager"
msgstr "Менеджер буфера обмена"

#: data/desktop/org.gnome.GPaste.Ui.desktop.in.in:5
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:7
msgid "Manage your clipboard history"
msgstr "Управляйте историей буфера обмена"

#: data/desktop/org.gnome.GPaste.Ui.desktop.in.in:6
msgid "Clipboard;Copy;Paste;History;Manager;"
msgstr ""
"Clipboard;Copy;Paste;History;Manager;буфер "
"обмена;копировать;вырезать;вставить;менеджер;история;"

#: data/desktop/org.gnome.GPaste.Ui.desktop.in.in:17
#: src/gnome-shell/actions.js:43 src/ui/gpaste-ui-header.c:123
msgid "Preferences"
msgstr "Параметры"

#: data/desktop/org.gnome.GPaste.Ui.desktop.in.in:21
msgid "About"
msgstr "О приложении"

#: data/gsettings/org.gnome.GPaste.gschema.xml:15
msgid "Max size of an element when displaying it"
msgstr "Максимальный размер элемента при его отображении"

#: data/gsettings/org.gnome.GPaste.gschema.xml:16
msgid ""
"Anything past that length is replaced by \"…\" when an element is shown in "
"the history, and newlines and tabs are shown as spaces. 0 disables the limit."
msgstr ""
"При показе элемента в истории, всё, что превышает указанную длину, "
"заменяется многоточием «…» , а переносы строк и табуляция отображаются как "
"пробелы. Значение 0 отключает ограничение."

#: data/gsettings/org.gnome.GPaste.gschema.xml:23
msgid "Detect and replace growing lines"
msgstr "Обнаружение и замена разрастающихся строк"

#: data/gsettings/org.gnome.GPaste.gschema.xml:24
msgid ""
"Copying \"Here is\", then \"Here is an example\", leaves two entries in the "
"history. With this enabled, the second replaces the first instead."
msgstr ""
"Копирование фраз «Вот» и «Вот пример» оставляет в истории две отдельные "
"записи. При включении этого параметра первая запись будет заменена второй."

#: data/gsettings/org.gnome.GPaste.gschema.xml:32
msgid "The name of the current history"
msgstr "Имя текущей истории"

#: data/gsettings/org.gnome.GPaste.gschema.xml:33
msgid "The default name is \"history\""
msgstr "Имя по умолчанию - «история»"

#: data/gsettings/org.gnome.GPaste.gschema.xml:40
msgid "Save copied images to the history"
msgstr "Сохранять скопированные изображения в историю"

#: data/gsettings/org.gnome.GPaste.gschema.xml:41
msgid "Enabled by default: images are kept alongside text."
msgstr "Включено по умолчанию: изображения сохраняются вместе с текстом."

#: data/gsettings/org.gnome.GPaste.gschema.xml:48
msgid "Show image previews in the history"
msgstr "Отображать в истории предварительный просмотр изображений"

#: data/gsettings/org.gnome.GPaste.gschema.xml:49
msgid "Enabled by default: an image item shows a thumbnail of itself."
msgstr ""
"Включено по умолчанию: элемент изображения в истории отображает свою "
"миниатюру."

#: data/gsettings/org.gnome.GPaste.gschema.xml:57
msgid "Size of image previews in pixels"
msgstr "Размер изображений при предварительном просмотре в пикселях"

#: data/gsettings/org.gnome.GPaste.gschema.xml:58
msgid ""
"Size of the inline image thumbnail in the history; the larger detail preview "
"is shown on hover. Default size is 50 pixels."
msgstr ""
"Размер миниатюры изображения в истории; более подробный вариант отображается "
"при наведении курсора. Размер по умолчанию — 50 пикселей."

#: data/gsettings/org.gnome.GPaste.gschema.xml:65
msgid "Close the UI after selecting an item"
msgstr "Закрывать пользовательский интерфейс после выбора элемента"

#: data/gsettings/org.gnome.GPaste.gschema.xml:66
#: data/gsettings/org.gnome.GPaste.gschema.xml:220
msgid "Enabled by default."
msgstr "Включено по умолчанию."

#: data/gsettings/org.gnome.GPaste.gschema.xml:73
msgid "Are the global keyboard shortcuts enabled?"
msgstr "Включены ли глобальные комбинации клавиш?"

#: data/gsettings/org.gnome.GPaste.gschema.xml:74
msgid ""
"By default, the global keyboard shortcuts are enabled. Disable this to "
"prevent GPaste from grabbing any global shortcut."
msgstr ""
"По умолчанию глобальные комбинации клавиш включены. Отключите эту функцию, "
"чтобы GPaste не мог использовать какие-либо глобальные сочетания клавиш."

#: data/gsettings/org.gnome.GPaste.gschema.xml:82
msgid "The keyboard shortcut to launch the graphical interface"
msgstr "Комбинация клавиш для запуска графического интерфейса"

#: data/gsettings/org.gnome.GPaste.gschema.xml:83
#: data/gsettings/org.gnome.GPaste.gschema.xml:91
#: data/gsettings/org.gnome.GPaste.gschema.xml:147
#: data/gsettings/org.gnome.GPaste.gschema.xml:172
#: data/gsettings/org.gnome.GPaste.gschema.xml:196
#: data/gsettings/org.gnome.GPaste.gschema.xml:204
#: data/gsettings/org.gnome.GPaste.gschema.xml:246
msgid "An empty string disables this shortcut."
msgstr "Пустая строка отключает эту комбинацию клавиш."

#: data/gsettings/org.gnome.GPaste.gschema.xml:90
msgid "The keyboard shortcut to mark the active item as being a password"
msgstr "Комбинация клавиш для пометки активного элемента как пароля"

#: data/gsettings/org.gnome.GPaste.gschema.xml:99
msgid "Max history size"
msgstr "Максимальный размер истории"

#: data/gsettings/org.gnome.GPaste.gschema.xml:100
msgid "Maximum number of items in history"
msgstr "Максимальное количество элементов в истории"

#: data/gsettings/org.gnome.GPaste.gschema.xml:108
msgid "Max memory usage (MB)"
msgstr "Максимальное использование памяти (МБ)"

#: data/gsettings/org.gnome.GPaste.gschema.xml:109
msgid "Maximum amount of memory used to store contents"
msgstr "Максимальный объем памяти, используемый для хранения содержимого"

#: data/gsettings/org.gnome.GPaste.gschema.xml:117
msgid "Max text item size"
msgstr "Максимальный размер текстового элемента"

#: data/gsettings/org.gnome.GPaste.gschema.xml:118
msgid "Maximum size of a text item. Anything out of this boundary is ignored."
msgstr ""
"Максимальный размер текстового элемента. Все, что выходит за пределы этой "
"границы, игнорируется."

#: data/gsettings/org.gnome.GPaste.gschema.xml:126
msgid "Min text item size"
msgstr "Минимальный размер текстового элемента"

#: data/gsettings/org.gnome.GPaste.gschema.xml:127
msgid "Minimum size of a text item. Anything out of this boundary is ignored."
msgstr ""
"Минимальный размер текстового элемента. Все, что выходит за пределы этой "
"границы, игнорируется."

#: data/gsettings/org.gnome.GPaste.gschema.xml:135
msgid "Password timeout"
msgstr "Таймаут пароля"

#: data/gsettings/org.gnome.GPaste.gschema.xml:136
msgid ""
"How long a password may stay on the clipboard, in seconds, once it is the "
"active item. When it runs out, the next item that is not a password is "
"selected, or the clipboard is emptied if the history holds none. 0 means a "
"password stays for as long as anything else would."
msgstr ""
"Время (в секундах), в течение которого пароль может оставаться в буфере "
"обмена, после того как станет активным элементом. По истечении этого времени "
"либо выбирается следующий по списку элемент не являющийся паролем, либо "
"буфер обмена очищается, если в истории не содержится других элементов. "
"Значение 0 означает, что пароль остается в буфере обмена столько же, сколько "
"и любой другой элемент."

#: data/gsettings/org.gnome.GPaste.gschema.xml:146
msgid "The keyboard shortcut to delete the first element in history"
msgstr "Комбинация клавиш для удаления первого элемента в истории"

#: data/gsettings/org.gnome.GPaste.gschema.xml:154
msgid "Let the primary selection affect the history"
msgstr "Пусть первичное выделение добавляется в историю буфера обмена"

#: data/gsettings/org.gnome.GPaste.gschema.xml:155
msgid "Disabled by default: only the clipboard (ctrl+c) affects the history."
msgstr ""
"По умолчанию отключено: на историю оказывает влияние только содержимое "
"буфера обмена (Ctrl+C)."

#: data/gsettings/org.gnome.GPaste.gschema.xml:162
msgid "Save every flavour of copied rich text"
msgstr "При копировании форматированного текста сохранять все варианты"

#: data/gsettings/org.gnome.GPaste.gschema.xml:163
msgid ""
"Enabled by default. When disabled, only the plain text of a rich text "
"selection (HTML and the like) is kept."
msgstr ""
"Включено по умолчанию. При отключении этого параметра выделенный фрагмент "
"форматированного текста (HTML и т.п.) сохраняется только в виде простого "
"текста."

#: data/gsettings/org.gnome.GPaste.gschema.xml:171
msgid "The keyboard shortcut to display the menu"
msgstr "Комбинация клавиш для отображения меню"

#: data/gsettings/org.gnome.GPaste.gschema.xml:179
msgid "Where the history is stored"
msgstr "Где хранится история"

#: data/gsettings/org.gnome.GPaste.gschema.xml:180
msgid ""
"The storage backend used to persist the history: \"file\" keeps it in an on-"
"disk file, \"sqlite\" in a per-history database (with \"encrypted-file\" and "
"\"encrypted-sqlite\" flavours), \"none\" keeps nothing."
msgstr ""

#: data/gsettings/org.gnome.GPaste.gschema.xml:187
msgid "Last processed storage backend revision"
msgstr "Последняя обработанная версия бэкенда хранилища"

#: data/gsettings/org.gnome.GPaste.gschema.xml:188
msgid ""
"Set by the daemon, not meant to be edited. When it falls behind the daemon's "
"own revision, the storage migration is offered again on startup."
msgstr ""

#: data/gsettings/org.gnome.GPaste.gschema.xml:195
msgid "The keyboard shortcut to sync the clipboard to the primary selection"
msgstr ""
"Комбинация клавиш для синхронизации буфера обмена с основным выделением"

#: data/gsettings/org.gnome.GPaste.gschema.xml:203
msgid "The keyboard shortcut to sync the primary selection to the clipboard"
msgstr ""
"Комбинация клавиш для синхронизации основного выделения с буфером обмена"

#: data/gsettings/org.gnome.GPaste.gschema.xml:211
msgid "Keep the primary selection and the clipboard in sync"
msgstr ""
"Следить за тем, чтобы основное выделение и буфер обмена были синхронизированы"

#: data/gsettings/org.gnome.GPaste.gschema.xml:212
msgid ""
"Disabled by default: the primary selection and the clipboard are independent."
msgstr ""
"По умолчанию отключено: Основное выделение и буфер обмена являются "
"независимыми."

#: data/gsettings/org.gnome.GPaste.gschema.xml:219
msgid "Track clipboard changes"
msgstr "Отслеживать изменения в буфере обмена"

#: data/gsettings/org.gnome.GPaste.gschema.xml:227
msgid "Match the daemon state to the GNOME Shell extension's"
msgstr "Синхронизировать состояние демона с состоянием расширения GNOME Shell"

#: data/gsettings/org.gnome.GPaste.gschema.xml:228
msgid ""
"When enabled, disabling the extension stops the daemon tracking as well. "
"Disabled by default: the daemon state is left alone."
msgstr ""

#: data/gsettings/org.gnome.GPaste.gschema.xml:236
msgid "Trim text items before adding them to the history"
msgstr "Обрезать текстовые элементы перед добавлением их в историю"

#: data/gsettings/org.gnome.GPaste.gschema.xml:237
msgid ""
"Trimming removes the leading and trailing whitespace. Disabled by default: "
"items are stored just as they were copied."
msgstr ""
"Обрезка означает удаление пробелов и символов перевода каретки в конце "
"строки. По умолчанию: элементы сохраняются в том виде, в котором были "
"скопированы."

#: data/gsettings/org.gnome.GPaste.gschema.xml:245
msgid ""
"The keyboard shortcut to upload the first element in history to a pastebin "
"service"
msgstr ""
"Комбинация клавиш для отправки первого элемента истории на сервис pastebin"

#: data/gsettings/org.gnome.GPaste.gschema.xml:253
msgid "Ask for confirmation before emptying a history"
msgstr "Запрашивать подтверждение при очистке истории"

#: data/gsettings/org.gnome.GPaste.gschema.xml:254
msgid "Enabled by default, because emptying a history cannot be undone."
msgstr "Включено по умолчанию, поскольку очистку истории отменить невозможно."

#: data/gsettings/org.gnome.GPaste.gschema.xml:261
msgid "Run the experimental in-shell (mutter) daemon"
msgstr "Использовать экспериментальный запуск демона внутри оболочки (mutter)"

#: data/gsettings/org.gnome.GPaste.gschema.xml:262
msgid ""
"Disabled by default: the GNOME Shell extension is a pure client and the "
"standalone daemon does the work."
msgstr ""
"Отключено по умолчанию: расширение gnome-shell работает как чистый клиент, а "
"работу выполняет автономный демон."

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:9
msgid "Marc-Antoine Perennou"
msgstr "Marc-Antoine Perennou"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:17
msgid ""
"GPaste is a clipboard managing system allowing you to track and manage your "
"clipboard history in a highly customizable way."
msgstr ""
"GPaste — это система управления буфером обмена, позволяющая отслеживать и "
"управлять историей буфера обмена с широкими возможностями настройки."

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:20
msgid ""
"GPaste provides you with a graphical tool allowing you to manage everything "
"easily."
msgstr ""
"GPaste предоставляет вам графический инструмент, позволяющий легко управлять "
"всем."

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:27
msgid "The main UI"
msgstr "Основной интерфейс"

#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:31
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:35
#: data/metainfo/org.gnome.GPaste.Ui.metainfo.xml.in:39
msgid "The settings UI"
msgstr "Настройки интерфейса"

#. Translators: %s is the program GPaste tried to start, then the reason it could not.
#: src/client/gpaste-client.c:173
#, c-format
msgid "Couldn't spawn %s: %s"
msgstr "Не удалось запустить: %s: %s"

#: src/client/gpaste-client.c:305
msgid "Successfully re-executed the daemon"
msgstr "Успешный перезапуск демона"

#: src/client/gpaste-client.c:319
msgid "Successfully triggered the storage migration"
msgstr "Миграция хранилища успешно запущена"

#: src/client/gpaste-client.c:336
msgid "Successfully triggered the passphrase change"
msgstr "Смена пароля прошла успешно"

#: src/client/gpaste-client.c:495
msgid "Cannot add non-UTF-8 data as text."
msgstr "Невозможно добавить данные, отличные от UTF-8, в качестве текста."

#: src/client/gpaste-client.c:732
msgid "print the history with UUIDs"
msgstr "выводить историю с UUID"

#: src/client/gpaste-client.c:733
msgid "print the size of the current history"
msgstr "выводить размер текущей истории"

#: src/client/gpaste-client.c:734
msgid "print the items of the history matching <pattern>"
msgstr "выводить элементы истории, соответствующие <pattern>"

#: src/client/gpaste-client.c:735
msgid "get the name of the current history"
msgstr "получить имя текущей истории"

#: src/client/gpaste-client.c:736
msgid "back up the current history"
msgstr "резервное копирование текущей истории"

#: src/client/gpaste-client.c:737
msgid "switch to another history"
msgstr "переключиться на другую историю"

#: src/client/gpaste-client.c:738
msgid "delete a history"
msgstr "удалить историю"

#: src/client/gpaste-client.c:739
msgid "list available histories"
msgstr "список доступных историй"

#: src/client/gpaste-client.c:740
msgid "set text to clipboard"
msgstr "установить текст в буфер обмена"

#: src/client/gpaste-client.c:741
msgid "add the <name> / <password> pair to the clipboard"
msgstr "добавить пару имя - пароль в буфер обмена"

#: src/client/gpaste-client.c:742
msgid "get the item <uuid> from the history"
msgstr "получить элемент <uuid> из истории"

#: src/client/gpaste-client.c:743
msgid "set the item <uuid> from the history to the clipboard"
msgstr "установить элемент <uuid> из истории в буфер обмена"

#: src/client/gpaste-client.c:744
msgid ""
"replace the contents of the item <uuid> from the history with the provided "
"one"
msgstr ""
"заменить содержимое элемента <uuid> из истории на предоставленный элемент"

#: src/client/gpaste-client.c:745
msgid ""
"merge the items matching the UUIDs from the history and put the result in "
"the clipboard"
msgstr ""
"объединить элементы, соответствующие UUID, из истории и поместить результат "
"в буфер обмена"

#: src/client/gpaste-client.c:746
msgid ""
"make the item <uuid> from the history a password named <name>, or update one "
"that is"
msgstr ""
"установить элемент <uuid> из истории в качестве пароля с именем <name> или "
"обновить существующий пароль"

#: src/client/gpaste-client.c:747
msgid "delete item <uuid> from the history"
msgstr "удалить элемент <uuid> из истории"

#: src/client/gpaste-client.c:748
msgid "pin item <uuid> so the history never drops it automatically"
msgstr ""

#: src/client/gpaste-client.c:749
msgid "unpin item <uuid>, letting the history drop it again"
msgstr ""

#: src/client/gpaste-client.c:750
msgid "delete the password <name> from the history"
msgstr "удалить пароль <name> из истории"

#: src/client/gpaste-client.c:751
msgid "put the content of the file at <path> into the clipboard"
msgstr "поместить содержимое файла <path> в буфер обмена"

#: src/client/gpaste-client.c:752
msgid "empty the history"
msgstr "очистить историю"

#: src/client/gpaste-client.c:753
msgid "start tracking clipboard changes"
msgstr "начать отслеживать изменения в буфере обмена"

#: src/client/gpaste-client.c:754
msgid "stop tracking clipboard changes"
msgstr "прекратить отслеживать изменения в буфере обмена"

#: src/client/gpaste-client.c:755
#, fuzzy
msgid "re-execute the daemon (after upgrading it, for instance)"
msgstr "перезапустить демон (после обновления ...)"

#: src/client/gpaste-client.c:756
msgid "migrate the history to a different storage backend"
msgstr ""

#: src/client/gpaste-client.c:757
msgid "change the passphrase of the encrypted history"
msgstr "изменить пароль зашифрованной истории"

#: src/client/gpaste-client.c:758
msgid "launch the configuration tool"
msgstr "запустить инструмент настройки"

#: src/client/gpaste-client.c:759
msgid "launch the graphical tool"
msgstr "запустить графический интерфейс"

#: src/client/gpaste-client.c:760
#, fuzzy
msgid "make the GNOME Shell extension display the history"
msgstr "заставить апплет или расширение отображать историю"

#: src/client/gpaste-client.c:761
msgid "upload the item <uuid> to a pastebin service"
msgstr "загрузить элемент <uuid> на сервис pastebin"

#: src/client/gpaste-client.c:762
msgid "display the version"
msgstr "показать версию"

#: src/client/gpaste-client.c:763
msgid "display the daemon version"
msgstr "показать версию демона"

#: src/client/gpaste-client.c:764
msgid "display this help"
msgstr "показать эту справку"

#: src/client/gpaste-client.c:765
msgid "display the about dialog"
msgstr "показать «О программе»"

#: src/client/gpaste-client.c:798
#, c-format
msgid "Usage:\n"
msgstr "Использование:\n"

#. Not a verb: the item comes in on stdin.
#. Translators: the metavariable standing for any command the user pipes into GPaste.
#: src/client/gpaste-client.c:819
msgid "<command>"
msgstr ""

#: src/client/gpaste-client.c:819

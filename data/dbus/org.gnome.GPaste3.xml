<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
                      "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  SPDX-FileCopyrightText: 2010-2026 Marc-Antoine Perennou <Marc-Antoine@Perennou.com>
  SPDX-License-Identifier: BSD-2-Clause

  The interface the GPaste daemon exports on /org/gnome/GPaste, and the single
  source of truth for both sides of it: gdbus-codegen turns this file into the
  GPasteDaemon3 GInterface, the proxy GPasteClient derives from, and the skeleton
  GPasteDaemon exports.

  Also installed to $datadir/dbus-1/interfaces so that anything speaking to the
  daemon can read the contract without building GPaste.
-->
<node>
  <!--
    org.gnome.GPaste3:
    @short_description: The GPaste daemon

    The "3" is the interface version, not a third daemon: it is what the C name
    below keeps, so that the generated g_paste_daemon3_* symbols never collide
    with the g_paste_daemon_* ones of the GPasteDaemon object that implements it.

    An item travels as (uuid, value, kind): everything a client needs to draw a
    row, in one reply. @kind is the GPasteItemKind value, the numeric one rather
    than its nick, which is now the storage backends' business alone.

    @value is the one string an item has here, the one a user is shown. There
    used to be a second, "raw" flavour of every getter, answering what a script
    might want instead: the uri list behind "[Files] ~/a", or the cache path
    behind "[Image, 800 x 600 (...)]". For plain text, which is nearly all of a
    history, the two were the same string, and neither was ever a password's
    real value. GetImage is where an image's bytes come from.
  -->
  <interface name="org.gnome.GPaste3">
    <annotation name="org.gtk.GDBus.C.Name" value="PasteDaemon3"/>

    <!-- Add the contents of a file to the history -->
    <method name="AddFile">
      <arg type="s" direction="in" name="file"/>
    </method>

    <!-- Add a password item to the history -->
    <method name="AddPassword">
      <arg type="s" direction="in" name="name"/>
      <arg type="s" direction="in" name="password"/>
    </method>

    <!-- Add a text item to the history -->
    <method name="AddText">
      <arg type="s" direction="in" name="text"/>
    </method>

    <!-- Backup a history under another name -->
    <method name="BackupHistory">
      <arg type="s" direction="in" name="history"/>
      <arg type="s" direction="in" name="backup"/>
    </method>

    <!-- Re-encrypt the history with a new passphrase, prompted for by the daemon -->
    <method name="ChangePassphrase"/>

    <!-- Delete a whole history -->
    <method name="DeleteHistory">
      <arg type="s" direction="in" name="name"/>
    </method>

    <!-- Delete one item from the history -->
    <method name="DeleteItem">
      <arg type="s" direction="in" name="uuid"/>
    </method>

    <!-- Delete a password item, by name -->
    <method name="DeletePassword">
      <arg type="s" direction="in" name="name"/>
    </method>

    <!-- Empty a history, keeping it around -->
    <method name="EmptyHistory">
      <arg type="s" direction="in" name="name"/>
    </method>

    <!-- The whole history -->
    <method name="GetHistory">
      <arg type="a(ssu)" direction="out" name="history"/>
    </method>

    <!-- How many items a given history holds -->
    <method name="GetHistorySize">
      <arg type="s" direction="in"  name="name"/>
      <arg type="t" direction="out" name="size"/>
    </method>

    <!--
      The raw image data of an image item.

      Kept out of the item struct on purpose: a PNG on every row of every
      history listing would dwarf everything else. A client knows from the
      item's kind whether to ask.

      ForceGVariant is load-bearing: the default mapping for "ay" is a C
      bytestring, which stops at the first NUL and would truncate every PNG.
    -->
    <method name="GetImage">
      <arg type="s"  direction="in"  name="uuid"/>
      <arg type="ay" direction="out" name="image">
        <annotation name="org.gtk.GDBus.C.ForceGVariant" value="true"/>
      </arg>
    </method>

    <!-- One item, by uuid -->
    <method name="GetItem">
      <arg type="s"      direction="in"  name="uuid"/>
      <arg type="(ssu)" direction="out" name="item"/>
    </method>

    <!-- The item at a given position -->
    <method name="GetItemAtIndex">
      <arg type="t"      direction="in"  name="index"/>
      <arg type="(ssu)" direction="out" name="item"/>
    </method>

    <!-- The items for the given uuids -->
    <method name="GetItems">
      <arg type="as"      direction="in"  name="uuids"/>
      <arg type="a(ssu)" direction="out" name="items"/>
    </method>

    <!-- The names of every known history -->
    <method name="ListHistories">
      <arg type="as" direction="out" name="histories"/>
    </method>

    <!-- Merge several items into a new one -->
    <method name="Merge">
      <arg type="s"  direction="in" name="decoration"/>
      <arg type="s"  direction="in" name="separator"/>
      <arg type="as" direction="in" name="uuids"/>
    </method>

    <!-- Have the daemon exec a fresh copy of itself -->
    <method name="Reexecute"/>

    <!-- Rename a password item -->
    <method name="RenamePassword">
      <arg type="s" direction="in" name="old_name"/>
      <arg type="s" direction="in" name="new_name"/>
    </method>

    <!--
      Tell the daemon whether the gnome-shell extension is running.

      A report, not an order: what to do about it is the daemon's
      "track-extension-state" policy, and a client does not second-guess it.
    -->
    <method name="ReportExtensionState">
      <arg type="b" direction="in" name="active"/>
    </method>

    <!-- Replace the contents of one item -->
    <method name="Replace">
      <arg type="s" direction="in" name="uuid"/>
      <arg type="s" direction="in" name="contents"/>
    </method>

    <!-- The items matching a query -->
    <method name="Search">
      <arg type="s"       direction="in"  name="query"/>
      <arg type="a(ssu)" direction="out" name="results"/>
    </method>

    <!-- Make one item the current selection -->
    <method name="Select">
      <arg type="s" direction="in" name="uuid"/>
    </method>

    <!-- Start or stop tracking clipboard changes; reads back as the Active property -->
    <method name="SetActive">
      <arg type="b" direction="in" name="active"/>
    </method>

    <!-- Turn one item into a password item -->
    <method name="SetPassword">
      <arg type="s" direction="in" name="uuid"/>
      <arg type="s" direction="in" name="name"/>
    </method>

    <!-- Show the about dialog -->
    <method name="ShowAbout"/>

    <!-- Ask for the history to be displayed -->
    <method name="ShowHistory"/>

    <!-- Switch to another history; the History property carries the outcome -->
    <method name="SwitchHistory">
      <arg type="s" direction="in" name="name"/>
    </method>

    <!-- Upload one item to a pastebin service -->
    <method name="Upload">
      <arg type="s" direction="in" name="uuid"/>
    </method>

    <!--
      Every signal below is generated under a "Raw" C name, hence a "raw-*"
      GObject signal on the proxy. GPasteClient re-emits each one under its
      public name: that keeps the public signal free to carry a richer payload
      (Update hands out GPasteUpdateAction/GPasteUpdateTarget enums rather than
      their numeric values) and keeps the whole public surface declared on
      GPasteClient itself, where the GIR and the VAPI can see it.
    -->

    <!-- A history was deleted -->
    <signal name="DeleteHistory">
      <annotation name="org.gtk.GDBus.C.Name" value="RawDeleteHistory"/>
      <arg type="s" name="history"/>
    </signal>

    <!-- A history was emptied -->
    <signal name="EmptyHistory">
      <annotation name="org.gtk.GDBus.C.Name" value="RawEmptyHistory"/>
      <arg type="s" name="history"/>
    </signal>

    <!--
      The set of histories changed, so anything listing them should ask again.

      Distinct from switching: a backup creates a history without making it the
      current one, which no change of the History property can express.
    -->
    <signal name="HistoriesChanged">
      <annotation name="org.gtk.GDBus.C.Name" value="RawHistoriesChanged"/>
    </signal>

    <!-- The history should be displayed -->
    <signal name="ShowHistory">
      <annotation name="org.gtk.GDBus.C.Name" value="RawShowHistory"/>
    </signal>

    <!--
      Something changed in the history.

      @action and @target are GPasteUpdateAction and GPasteUpdateTarget values.
      @uuid names the item @target == ITEM refers to and @index says where it
      sat; a view listing something other than positions (a search, the
      favourites) can only act on the former. Both are empty/zero for
      @target == ALL.
    -->
    <signal name="Update">
      <annotation name="org.gtk.GDBus.C.Name" value="RawUpdate"/>
      <arg type="u" name="action"/>
      <arg type="u" name="target"/>
      <arg type="s" name="uuid"/>
      <arg type="t" name="index"/>
    </signal>

    <!-- Whether the daemon is tracking clipboard changes -->
    <property name="Active" type="b" access="read"/>

    <!-- The name of the history currently in use -->
    <property name="History" type="s" access="read"/>

    <!-- The version of the running daemon -->
    <property name="Version" type="s" access="read"/>
  </interface>
</node>

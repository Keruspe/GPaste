  SPDX-License-Identifier: BSD-2-Clause

  The interface the GPaste daemon exports on /org/gnome/GPaste, and the single
  source of truth for both sides of it: gdbus-codegen turns this file into the
  GPasteDaemon3 GInterface, the proxy GPasteClient derives from, and the skeleton
  GPasteDaemon exports.

  Also installed to $datadir/dbus-1/interfaces so that anything speaking to the
  daemon can read the contract without building GPaste.
-->
<node>
  <!--
    org.gnome.GPaste3:
    @short_description: The GPaste daemon

    The "3" is the interface version, not a third daemon: it is what the C name
    below keeps, so that the generated g_paste_daemon3_* symbols never collide
    with the g_paste_daemon_* ones of the GPasteDaemon object that implements it.

    THE CURRENT HISTORY IS WHAT EVERY ITEM CALL ACTS ON. Reading items
    (GetHistory, GetItem, GetItemAtIndex, GetItems, GetFavourites, GetImage,
    GetUris, Search, GetHistorySize) and changing them (the Add* calls, Merge,
    Replace, MakePassword, Select, SetFavourite, DeleteItem, DeletePassword,
    RenamePassword) never name a history: they are about the one in use, which
    the History property carries.
    The calls that name a history are the ones that treat histories as objects
    rather than as a place to put items: ListHistories, BackupHistory,
    EmptyHistory, DeleteHistory and SwitchHistory. Inspecting another history
    means switching to it.

    An item travels as (uuid, value, kind, favourite): everything a client needs
    to draw a row, in one reply. @kind is the GPasteItemKind value, the numeric
    one rather than its nick, which is now the storage backends' business alone;
    the DocString annotation below spells the numbers out, so a client that
    never sees GPaste's headers can still read them off Introspect().

    @value is the one string an item has here, the one a user is shown. There
    used to be a second, "raw" flavour of every getter, answering what a script
    might want instead: the uri list behind "[Files] ~/a", or the cache path
    behind "[Image, 800 x 600 (...)]". For plain text, which is nearly all of a
    history, the two were the same string, and neither was ever a password's
    real value. GetImage is where an image's bytes come from and GetUris the uris
    a files item holds; a colour item's colour is simply its value.
  -->
  <interface name="org.gnome.GPaste3">
    <annotation name="org.gtk.GDBus.C.Name" value="PasteDaemon3"/>

    <!--
      The one thing a client cannot work out from the signatures alone: what the
      numbers mean. Carried as annotations rather than only as comments so they
      come back from Introspect() over the bus, where a client that never read
      this file can still find them.

      Under a name of GPaste's own, not org.gtk.GDBus.DocString: gdbus-codegen
      consumes anything in its own namespace as an instruction to itself and
      emits none of it into the GDBusInterfaceInfo the skeleton answers
      Introspect() from, which is the one place these have to reach.
    -->
    <annotation name="org.gnome.GPaste3.ItemKind"
                value="0=invalid 1=text 2=uris 3=image 4=password 5=color"/>

    <!--
      Add the contents of a file to the history.

      @path is read by the daemon, so it must be one the daemon can reach; a
      client resolves a relative one against its own directory first. A file that
      is not valid UTF-8 is tried as an image.
    -->
    <method name="AddFile">
      <arg type="s" direction="in"  name="path"/>
      <arg type="s" direction="out" name="uuid"/>
    </method>

    <!-- Add a password item to the history -->
    <method name="AddPassword">
      <arg type="s" direction="in"  name="name"/>
      <arg type="s" direction="in"  name="password"/>
      <arg type="s" direction="out" name="uuid"/>
    </method>

    <!-- Add a text item to the history -->
    <method name="AddText">
      <arg type="s" direction="in"  name="text"/>
      <arg type="s" direction="out" name="uuid"/>
    </method>

    <!--
      Backup a history under another name.

      Refuses with .Error.AlreadyExists rather than overwrite a history already
      called @backup: a backup silently destroying an older one of the same name
      is a loss noticed far too late.
    -->
    <method name="BackupHistory">
      <arg type="s" direction="in" name="history"/>
      <arg type="s" direction="in" name="backup"/>
    </method>

    <!-- Re-encrypt the history with a new passphrase, prompted for by the daemon -->
    <method name="ChangePassphrase"/>

    <!-- Delete a whole history -->
    <method name="DeleteHistory">
      <arg type="s" direction="in" name="name"/>
    </method>

    <!-- Delete one item from the history -->
    <method name="DeleteItem">
      <arg type="s" direction="in" name="uuid"/>
    </method>

    <!-- Delete a password item, by name -->
    <method name="DeletePassword">
      <arg type="s" direction="in" name="name"/>
    </method>

    <!-- Empty a history, keeping it around -->
    <method name="EmptyHistory">
      <arg type="s" direction="in" name="name"/>
    </method>

    <!--
      The pinned items, and only those.

      A listing of its own rather than a flag to sift GetHistory by: the daemon
      is where the flag lives, and a view showing a handful of pinned rows out
      of a history thousands long has no business pulling the thousands across
      the bus to throw nearly all of them away. A client wanting the pinned
      matches of a search still filters those itself, the matches being the
      narrow set already.
    -->
    <method name="GetFavourites">
      <arg type="a(ssub)" direction="out" name="favourites"/>
    </method>

    <!-- The whole history -->
    <method name="GetHistory">
      <arg type="a(ssub)" direction="out" name="history"/>
    </method>

    <!--
      How many items the current history holds.

      The sizes of the *other* histories come from ListHistories, which answers
      all of them at once: asking here for one history at a time is what used to
      make a sidebar listing every history cost the daemon one full load each.
    -->
    <method name="GetHistorySize">
      <arg type="t" direction="out" name="size"/>
    </method>

    <!--
      The raw image data of an image item.

      Kept out of the item struct on purpose: a PNG on every row of every
      history listing would dwarf everything else. A client knows from the
      item's kind whether to ask.

      ForceGVariant is load-bearing: the default mapping for "ay" is a C
      bytestring, which stops at the first NUL and would truncate every PNG.
    -->
    <method name="GetImage">
      <arg type="s"  direction="in"  name="uuid"/>
      <arg type="ay" direction="out" name="image">
        <annotation name="org.gtk.GDBus.C.ForceGVariant" value="true"/>
      </arg>
    </method>

    <!-- One item, by uuid -->
    <method name="GetItem">
      <arg type="s"      direction="in"  name="uuid"/>
      <arg type="(ssub)" direction="out" name="item"/>
    </method>

    <!-- The item at a given position -->
    <method name="GetItemAtIndex">
      <arg type="t"      direction="in"  name="index"/>
      <arg type="(ssub)" direction="out" name="item"/>
    </method>

    <!-- The items for the given uuids -->
    <method name="GetItems">
      <arg type="as"      direction="in"  name="uuids"/>
      <arg type="a(ssub)" direction="out" name="items"/>
    </method>

    <!--
      The uris a files item holds.

      A files item's @value is these same uris joined by newlines, which is
      unambiguous to split (a uri percent-encodes what would otherwise be a
      separator), so this exists for the shape of the answer rather than to
      recover anything: an array is what a client acting on the files wants,
      where @value is the one string an item travels with. Any scheme travels
      here, not just file:, since that is what a client copying from a remote
      mount put on the clipboard.

      Nothing in this tree calls it: the two front ends draw a files item from
      the value they already hold, and neither acts on the files. It is here for
      the consumers that do, since this interface is what GPaste offers anyone
      scripting it rather than merely what its own clients happen to need.
    -->
    <method name="GetUris">
      <arg type="s"  direction="in"  name="uuid"/>
      <arg type="as" direction="out" name="uris"/>
    </method>

    <!--
      Every known history, each with how many items it holds.

      The size rides along because everything that lists histories draws their
      sizes beside them, and asking per history meant one full load of one
      history apiece, inside the daemon's main loop. The order is the storage
      backend's, which is the order such a listing is drawn in.
    -->
    <method name="ListHistories">
      <arg type="a(st)" direction="out" name="histories"/>
    </method>

    <!-- Turn one item into a password item -->
    <method name="MakePassword">
      <arg type="s" direction="in"  name="uuid"/>
      <arg type="s" direction="in"  name="name"/>
      <arg type="s" direction="out" name="new_uuid"/>
    </method>

    <!--
      Merge several items into a new one.

      Daemon-side because it has to be: what gets joined is each item's real
      value, and the only string an item travels with here is the one a user is
      shown. @decoration wraps each item, @separator goes between them.
    -->
    <method name="Merge">
      <arg type="s"  direction="in"  name="decoration"/>
      <arg type="s"  direction="in"  name="separator"/>
      <arg type="as" direction="in"  name="uuids"/>
      <arg type="s"  direction="out" name="uuid"/>
    </method>

    <!-- Have the daemon exec a fresh copy of itself -->
    <method name="Reexecute"/>

    <!-- Rename a password item -->
    <method name="RenamePassword">
      <arg type="s" direction="in" name="old"/>
      <arg type="s" direction="in" name="new"/>
    </method>

    <!--
      Tell the daemon whether the gnome-shell extension is running.

      A report, not an order: what to do about it is the daemon's
      "track-extension-state" policy, and a client does not second-guess it.
    -->
    <method name="ReportExtensionState">
      <arg type="b" direction="in" name="active"/>
    </method>

    <!--
      Replace the contents of one item.

      The replacement is an item of its own, with a uuid of its own: that is what
      comes back, and why the Update this raises names no item.
    -->
    <method name="Replace">
      <arg type="s" direction="in"  name="uuid"/>
      <arg type="s" direction="in"  name="contents"/>
      <arg type="s" direction="out" name="new_uuid"/>
    </method>

    <!-- The items matching a query -->
    <method name="Search">
      <arg type="s"       direction="in"  name="query"/>
      <arg type="a(ssub)" direction="out" name="results"/>
    </method>

    <!-- Make one item the current selection -->
    <method name="Select">
      <arg type="s" direction="in" name="uuid"/>
    </method>

    <!-- Start or stop tracking clipboard changes; reads back as the Active property -->
    <method name="SetActive">
      <arg type="b" direction="in" name="active"/>
    </method>

    <!--
      Pin an item, or let it go again.

      A favourite is never dropped by an automatic policy: neither the history
      size limit nor the memory one may evict it. Emptying or deleting its
      history, or deleting it by uuid, still does.
    -->
    <method name="SetFavourite">
      <arg type="s" direction="in" name="uuid"/>
      <arg type="b" direction="in" name="favourite"/>
    </method>

    <!-- Ask for the history to be displayed -->
    <method name="ShowHistory"/>

    <!--
      Switch to another history.

      Switching to a name no history goes by creates it, empty: that is how a new
      history comes into being, there being no CreateHistory of its own. The
      History property carries the outcome, and HistoriesChanged is raised when
      the switch did create one.
    -->
    <method name="SwitchHistory">
      <arg type="s" direction="in" name="name"/>
    </method>

    <!--
      Upload one item to a pastebin service, and answer where it landed.

      The reply comes when the upload has finished, not when it has started, and
      an upload that failed fails this call. What to do with the url is the
      caller's business: it is not added to the history. An empty @uuid means the
      current item, which is what the keyboard shortcut uploads.
    -->
    <method name="Upload">
      <arg type="s" direction="in"  name="uuid"/>
      <arg type="s" direction="out" name="url"/>
    </method>

    <!--
      Every signal below is generated under a "Raw" C name, hence a "raw-*"
      GObject signal on the proxy. GPasteClient re-emits each one under its
      public name: that keeps the public signal free to carry a richer payload
      (Update hands out GPasteUpdateAction/GPasteUpdateTarget enums rather than
      their numeric values) and keeps the whole public surface declared on
      GPasteClient itself, where the GIR and the VAPI can see it.

      They are named for what happened rather than for the method that did it,
      which is also what keeps a signal from sharing a name with a method: the
      two live in one namespace for generated bindings, and a language mapping
      both onto members of one class has nowhere to put the second. ShowHistory
      is the one pair that does share a name, and has to: the signal is a
      request rather than a report of something that happened, and it is what
      the method of that name forwards. Its "Raw" C name is what keeps the
      generated C side of the two apart.
    -->

    <!--
      The set of histories changed, so anything listing them should ask again.

      Distinct from switching: a backup creates a history without making it the
      current one, which no change of the History property can express. Raised
      by every membership change: a backup, a deletion, and an empty or a
      switch that named a history there was none of.
    -->
    <signal name="HistoriesChanged">
      <annotation name="org.gtk.GDBus.C.Name" value="RawHistoriesChanged"/>
    </signal>

    <!-- A history was deleted -->
    <signal name="HistoryDeleted">
      <annotation name="org.gtk.GDBus.C.Name" value="RawHistoryDeleted"/>
      <arg type="s" name="history"/>
    </signal>

    <!-- A history was emptied -->
    <signal name="HistoryEmptied">
      <annotation name="org.gtk.GDBus.C.Name" value="RawHistoryEmptied"/>
      <arg type="s" name="history"/>
    </signal>

    <!-- The history should be displayed -->
    <signal name="ShowHistory">
      <annotation name="org.gtk.GDBus.C.Name" value="RawShowHistory"/>
    </signal>

    <!--
      Something changed in the history.

      @action and @target are GPasteUpdateAction and GPasteUpdateTarget values.
      @uuid names the item @target == ITEM refers to and @index says where it
      sat; a view listing something other than positions (a search, the
      favourites) can only act on the former. Both are empty/zero for
      @target == ALL.
    -->
    <signal name="Update">
      <annotation name="org.gtk.GDBus.C.Name" value="RawUpdate"/>
      <arg type="u" name="action">
        <annotation name="org.gnome.GPaste3.UpdateAction" value="0=invalid 1=replace 2=remove"/>
      </arg>
      <arg type="u" name="target">
        <annotation name="org.gnome.GPaste3.UpdateTarget" value="0=invalid 1=all 2=item"/>
      </arg>
      <arg type="s" name="uuid"/>
      <arg type="t" name="index"/>
    </signal>

    <!-- Whether the daemon is tracking clipboard changes -->
    <property name="Active" type="b" access="read"/>

    <!-- The name of the history currently in use -->
    <property name="History" type="s" access="read"/>

    <!-- The version of the running daemon -->
    <property name="Version" type="s" access="read"/>
  </interface>
</node>
